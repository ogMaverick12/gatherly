# Gatherly environment variables.
# Copy to `.env.local` and fill in what you need. Never commit real keys.
# All of these are read on the SERVER only. There is deliberately no NEXT_PUBLIC_ variant.

# Which provider powers the AI routes.
#   basic     - deterministic, no outbound call, no key (default)
#   gemini    - Google Gemini via @google/genai
#   openrouter- OpenRouter chat-completions API
#
# To switch the AI on, set the provider AND its key below. With no key the
# app answers in Basic mode and the badge says so.
GATHERLY_AI_PROVIDER=basic

# Google Gemini API key (server-only). Read by the Gemini adapter only.
GEMINI_API_KEY=

# OpenRouter API key (server-only). Read by the OpenRouter adapter only.
OPENROUTER_API_KEY=

# Optional: model identifiers.
GATHERLY_GEMINI_MODEL=gemini-2.0-flash
GATHERLY_OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: production rate limiting. When both are set the shared-store
# limiter is used instead of the in-process development limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
